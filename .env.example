# =====================================================================
# TransitPulse environment template
#
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# =====================================================================

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=transitpulse
MYSQL_USER=transitpulse
MYSQL_PASSWORD=change_me_app_password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# ---------------- application ports ----------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
SERVER_PORT=8080

# ---------------- backend ----------------
SPRING_PROFILES_ACTIVE=dev
TRANSITPULSE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRANSITPULSE_DATASETS_DIR=../datasets
TRANSITPULSE_ENGINE_OUTPUT=../data-engine/output
TRANSITPULSE_LOAD_DATASETS=true
TRANSITPULSE_LOG_LEVEL=INFO

# ---------------- frontend ----------------
# Leave empty to use the Vite dev-server proxy.
VITE_API_BASE_URL=
VITE_API_TARGET=http://localhost:8080

# ---------------- Snowflake ----------------
# Used by SnowSQL and the optional Python loader. Prefer key-pair auth.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSITPULSE_ROLE
SNOWFLAKE_WAREHOUSE=TRANSITPULSE_WH
SNOWFLAKE_DATABASE=TRANSITPULSE
SNOWFLAKE_SCHEMA=RAW
# Path to a private key for key-pair authentication (recommended).
SNOWFLAKE_PRIVATE_KEY_PATH=

# ---------------- AWS ----------------
# Leave these empty and use an IAM role, an AWS profile, or `aws configure`.
AWS_REGION=eu-west-2
AWS_PROFILE=
S3_BUCKET=your-transitpulse-bucket
S3_RAW_PREFIX=transitpulse/raw
S3_PROCESSED_PREFIX=transitpulse/processed



# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=transitpulse
MYSQL_USER=transitpulse
MYSQL_PASSWORD=change_me_app_password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# ---------------- application ports ----------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
SERVER_PORT=8080

# ---------------- backend ----------------
SPRING_PROFILES_ACTIVE=dev
TRANSITPULSE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRANSITPULSE_DATASETS_DIR=../datasets
TRANSITPULSE_ENGINE_OUTPUT=../data-engine/output
TRANSITPULSE_LOAD_DATASETS=true
TRANSITPULSE_LOG_LEVEL=INFO

# ---------------- frontend ----------------
# Leave empty to use the Vite dev-server proxy.
VITE_API_BASE_URL=
VITE_API_TARGET=http://localhost:8080



# ---------------- AWS ----------------
# Leave these empty and use an IAM role, an AWS profile, or `aws configure`.
AWS_REGION=eu-west-2
AWS_PROFILE=
S3_BUCKET=your-transitpulse-bucket
S3_RAW_PREFIX=transitpulse/raw
S3_PROCESSED_PREFIX=transitpulse/processed

# ---------------- JWT ----------------
JWT_SECRET=replace_with_a_unique_base64_secret
JWT_EXPIRATION_MINUTES=480


GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password
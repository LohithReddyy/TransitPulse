# ---------- build stage ----------
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

# Copy the POM first so dependency resolution is cached across code changes.
COPY backend/pom.xml .
RUN mvn -B dependency:go-offline

COPY backend/src ./src
RUN mvn -B clean package -DskipTests

# ---------- runtime stage ----------
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Run as a non-root user.
RUN addgroup -S transitpulse && adduser -S transitpulse -G transitpulse

COPY --from=build /build/target/transitpulse-backend.jar app.jar

# Datasets and engine output are mounted at runtime by docker-compose.
RUN mkdir -p /app/datasets /app/engine-output \
    && chown -R transitpulse:transitpulse /app

USER transitpulse
EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=docker \
    JAVA_OPTS="-XX:MaxRAMPercentage=75"

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/api/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
